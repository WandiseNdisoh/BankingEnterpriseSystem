@model BankingEnterpriseSystem.Models.Customer

@{
    ViewBag.Title = "Deposit Funds";
}

<div class="container" style="margin-top: 30px; max-width: 600px;">
    <div class="panel panel-primary" style="border-color: #3b82f6; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
        <div class="panel-heading" style="background-color: #3b82f6; border-color: #3b82f6; padding: 15px;">
            <h3 class="panel-title" style="font-weight: 600; font-size: 1.25rem;">Deposit Funds</h3>
        </div>
        <div class="panel-body" style="padding: 25px;">

            @if (Model != null)
            {
                <!-- Account Metadata Details -->
                <div class="well" style="background-color: #F8FAFC; border: 1px solid #E2E8F0; padding: 15px; margin-bottom: 20px; border-radius: 6px;">
                    <h4 style="margin-top: 0; color: #1E293B;"><strong>Account Holder:</strong> @Model.Name</h4>
                    <p style="margin-bottom: 0; color: #64748B;">
                        <strong>Current Balance:</strong>
                        <span style="color: #10B981; font-weight: 700;">R @String.Format("{0:N2}", Model.Balance)</span>
                    </p>
                </div>

                using (Html.BeginForm("Deposit", "Transaction", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <!-- Use Model context explicitly instead of a local customer variable -->
                    @Html.HiddenFor(m => m.customerId)

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label style="font-weight: 600; color: #334155; margin-bottom: 8px; display: block;">Amount to Deposit (ZAR)</label>
                        <div class="input-group">
                            <span class="input-group-addon" style="background-color: #F1F5F9; font-weight: 600;">R</span>
                            <input type="number" name="amount" step="0.01" class="form-control" required placeholder="0.00" style="height: 45px; font-size: 1.1rem;" />
                        </div>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "margin-top: 10px;" })
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 25px;">
                        <button type="submit" class="btn btn-success" style="padding: 10px 20px; font-weight: 600; background-color: #10B981; border-color: #10B981; flex: 1;">
                            Confirm Deposit
                        </button>
                        <a href="@Url.Action("Index", "Customer")" class="btn btn-default" style="padding: 10px 20px; border: 1px solid #CBD5E1; color: #64748B;">Cancel</a>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-danger">
                    Error: No client context was provided.
                </div>
                <a href="@Url.Action("Index", "Customer")" class="btn btn-default">Return to Customers</a>
            }

        </div>
    </div>
</div>